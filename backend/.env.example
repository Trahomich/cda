# Скопируйте в .env и при необходимости поправьте значения.
# Все настройки читаются через pydantic-settings (app/core/config.py).

APP_NAME="ЦДА backend"
ENV=local                      # local | dev | prod
LOG_LEVEL=INFO

# PostgreSQL 18 + PostGIS
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cda
POSTGRES_USER=cda
POSTGRES_PASSWORD=cda_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API
API_V1_PREFIX=/api/v1

# Аутентификация (MVP-4): в prod JWT_SECRET обязателен, длинная случайная строка
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
FARM_NAME=КФХ «Восход»
