# Скопируйте в .env и при необходимости поправьте значения.
# Все настройки читаются через pydantic-settings (app/core/config.py).

APP_NAME="ЦДА backend"
ENV=local                      # local | dev | prod
LOG_LEVEL=INFO

# PostgreSQL 18 + PostGIS
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cda
POSTGRES_USER=cda
POSTGRES_PASSWORD=cda_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API
API_V1_PREFIX=/api/v1

# Аутентификация (MVP-4): в prod JWT_SECRET обязателен, длинная случайная строка
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
FARM_NAME=КФХ «Восход»

# Погода (MVP-6): опрос Open-Meteo; в local по умолчанию выключен
WEATHER_POLL_ENABLED=false   # true — в docker-compose api: джобы 30 мин / 3 ч
WEATHER_POLL_CURRENT_MINUTES=30
WEATHER_POLL_FORECAST_HOURS=3
WEATHER_FORECAST_DAYS=7
WEATHER_RETRY_ATTEMPTS=5
WEATHER_RETRY_BASE_SECONDS=60
WEATHER_REQUEST_TIMEOUT=10

# Спутник (MVP-10): опрос каталога Sentinel-2 раз в 6 ч; в local выключен —
# нужен аккаунт Copernicus Data Space (https://dataspace.copernicus.eu)
SATELLITE_ENABLED=false

# Алерты (MVP-12): генераторы на событиях шины; периодический прогон опционален
ALERTS_POLL_ENABLED=false

COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# LLM-сводки (docs/09 §8.1): провайдер ollama (по умолчанию, локальный
# Ollama, пустой OLLAMA_BASE_URL = ИИ-текст выключен) или anthropic —
# anthropic-совместимое облако api.z.ai, модель glm-5.3-flash.
# ANTHROPIC_API_KEY — только из env, в репу не попадать.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:9b
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=glm-5.3-flash
