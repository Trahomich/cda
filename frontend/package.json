{
  "name": "cda-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Веб/PWA-клиент ИС «Цифровой двойник агронома» (ЦДА). Стек по ADR-06: Vue 3 + Vite + TypeScript, Pinia, Leaflet, vite-plugin-pwa.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "leaflet": "^1.9.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vue-tsc": "^2.1.10"
  }
}
